_fzf_cd() {
  local dir
  dir=$(fd --type d --hidden --follow --exclude .git | fzf +m) || return

  if [[ -n $dir ]]; then
    BUFFER="cd $dir"
    CURSOR=${#BUFFER}
    zle accept-line
  fi
}
